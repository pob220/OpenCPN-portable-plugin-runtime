package opencpn:opp@0.4.0;

interface types {
  record service-error {
    code: string,
    message: string,
    retryable: bool,
  }

  enum surface-role {
    tool-window,
    preferences,
    options-page,
    modal-task,
    dockable-panel,
    inspector,
  }

  enum communication-protocol {
    nmea0183,
    nmea2000,
    internal,
  }

  record communication-endpoint {
    id: string,
    protocol: communication-protocol,
    label: string,
  }

  enum https-method {
    get,
    post,
    put,
    patch,
    delete,
  }

  record https-header {
    name: string,
    value: string,
  }

  record https-request {
    request-id: string,
    method: https-method,
    url: string,
    headers: list<https-header>,
    body: list<u8>,
    timeout-milliseconds: u32,
    maximum-response-bytes: u64,
  }

  record https-response {
    status: u16,
    headers: list<https-header>,
    body: list<u8>,
    final-url: string,
  }

  enum log-level {
    debug,
    info,
    warning,
    error,
  }

  record vessel-position {
    latitude: f64,
    longitude: f64,
    course-over-ground: option<f64>,
    speed-over-ground: option<f64>,
    heading-true: option<f64>,
    heading-magnetic: option<f64>,
    magnetic-variation: option<f64>,
    fix-unix-time: option<s64>,
    satellites: option<u16>,
  }

  record geo-point {
    latitude: f64,
    longitude: f64,
  }

  record color {
    red: u8,
    green: u8,
    blue: u8,
    alpha: u8,
  }

  enum action-location {
    toolbar,
    chart-context-menu,
    ais-context-menu,
    route-context-menu,
    waypoint-context-menu,
    track-context-menu,
  }

  record action-context {
    location: action-location,
    canvas-index: option<u32>,
    position: option<geo-point>,
    object-kind: option<string>,
    object-id: option<string>,
  }

  record action-invocation {
    action-id: string,
    context: action-context,
  }

  record action-registration {
    action-id: string,
    label: string,
    tooltip: string,
    icon-resource: option<string>,
    locations: list<action-location>,
  }

  record action-state {
    visible: bool,
    enabled: bool,
    checkable: bool,
    checked: bool,
  }

  enum navigation-object-kind {
    waypoint,
    route,
    track,
  }

  record navigation-point {
    id: string,
    name: string,
    latitude: f64,
    longitude: f64,
    unix-time: option<s64>,
    description: string,
    icon-name: option<string>,
    visible: bool,
  }

  record navigation-object {
    id: string,
    kind: navigation-object-kind,
    name: string,
    description: string,
    points: list<navigation-point>,
    revision: string,
    visible: bool,
    active: bool,
  }

  record navigation-object-ref {
    kind: navigation-object-kind,
    id: string,
  }

  variant navigation-mutation {
    create(navigation-object),
    update(navigation-object),
    delete(navigation-object-ref),
  }

  record navigation-mutation-result {
    id: string,
    revision: string,
    diagnostic: string,
  }

  record navigation-page {
    objects: list<navigation-object>,
    next-cursor: option<string>,
  }

  record scene-style {
    stroke: option<color>,
    fill: option<color>,
    width-pixels: f32,
    dash-pattern: list<f32>,
  }

  enum scene-canvas-target {
    all,
    primary,
    selected,
  }

  enum scene-render-phase {
    below-vessels,
    above-vessels,
    above-ui,
  }

  record polyline-primitive {
    primitive-id: string,
    points: list<geo-point>,
    style: scene-style,
    interactive: bool,
  }

  record polygon-primitive {
    primitive-id: string,
    points: list<geo-point>,
    style: scene-style,
    interactive: bool,
  }

  record circle-primitive {
    primitive-id: string,
    centre: geo-point,
    radius-metres: f64,
    style: scene-style,
    interactive: bool,
  }

  record icon-primitive {
    primitive-id: string,
    position: geo-point,
    resource-name: string,
    width-pixels: f32,
    height-pixels: f32,
    rotation-degrees: f32,
    anchor-x: f32,
    anchor-y: f32,
    interactive: bool,
  }

  record text-primitive {
    primitive-id: string,
    position: geo-point,
    value: string,
    color: color,
    size-pixels: f32,
    rotation-degrees: f32,
    horizontal-alignment: string,
    interactive: bool,
  }

  variant scene-primitive {
    polyline(polyline-primitive),
    polygon(polygon-primitive),
    circle(circle-primitive),
    icon(icon-primitive),
    text(text-primitive),
  }

  record scene-layer {
    layer-id: string,
    z-index: s32,
    visible: bool,
    primitives: list<scene-primitive>,
  }

  record scene-update {
    scene-id: string,
    revision: u64,
    replace: bool,
    canvas-target: scene-canvas-target,
    selected-canvases: list<u32>,
    render-phase: scene-render-phase,
    layers: list<scene-layer>,
  }

  enum pointer-kind {
    move,
    press,
    release,
    double-click,
    wheel,
  }

  enum pointer-button {
    none,
    primary,
    middle,
    secondary,
  }

  record input-modifiers {
    shift: bool,
    control: bool,
    alt: bool,
    meta: bool,
  }

  record pointer-event {
    kind: pointer-kind,
    button: pointer-button,
    canvas-index: u32,
    x-pixels: s32,
    y-pixels: s32,
    position: option<geo-point>,
    wheel-rotation: s32,
    modifiers: input-modifiers,
    hit-scene-id: option<string>,
    hit-primitive-id: option<string>,
  }

  record key-event {
    key-code: u32,
    unicode: option<char>,
    pressed: bool,
    repeat: bool,
    modifiers: input-modifiers,
  }

  record timer-event {
    timer-id: string,
    scheduled-unix-milliseconds: s64,
    fired-unix-milliseconds: s64,
  }

  record rpc-request {
    correlation-id: string,
    service: string,
    method: string,
    content-type: string,
    payload: list<u8>,
    timeout-milliseconds: u32,
  }

  record rpc-response {
    correlation-id: string,
    status: u16,
    content-type: string,
    payload: list<u8>,
    diagnostic: string,
  }

  enum event-kind {
    nmea0183,
    nmea2000,
    signal-k,
    navigation-position,
    ais-target,
    active-leg,
    cursor,
    viewport,
    plugin-message,
    host-environment,
  }

  record nmea2000-event {
    pgn: u32,
    source: string,
    payload: list<u8>,
  }

  record active-leg-event {
    cross-track-error-nautical-miles: f64,
    bearing-degrees-true: f64,
    distance-nautical-miles: f64,
    waypoint-name: string,
    arrival: bool,
  }

  record viewport-event {
    west: f64,
    south: f64,
    east: f64,
    north: f64,
    scale-pixels-per-metre: f64,
    rotation-radians: f64,
    canvas-index: u32,
  }

  record plugin-message-event {
    message-id: string,
    message-body: string,
  }

  enum color-scheme {
    day,
    dusk,
    night,
  }

  record host-environment-snapshot {
    host-version: string,
    opp-api-name: string,
    locale: string,
    color-scheme: color-scheme,
    display-scale: f32,
    distance-unit: string,
    speed-unit: string,
    wind-speed-unit: string,
    depth-unit: string,
    temperature-unit: string,
  }

  variant event-payload {
    nmea0183(string),
    nmea2000(nmea2000-event),
    signal-k(string),
    navigation-position(vessel-position),
    ais-target(string),
    active-leg(active-leg-event),
    cursor(geo-point),
    viewport(viewport-event),
    plugin-message(plugin-message-event),
    host-environment(host-environment-snapshot),
  }

  record event {
    topic: string,
    payload: event-payload,
    sequence: u64,
  }

  record subscription {
    kind: event-kind,
    topic-prefix: string,
    queue-limit: u16,
  }
}
