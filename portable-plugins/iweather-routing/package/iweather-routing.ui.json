{
  "schema": "org.opencpn.portable-ui/0.2",
  "surface": "routing-workbench",
  "title": "Weather Routing — iWeatherRouting",
  "menus": [
    {"label": "&File", "items": [
      {"id": "close", "label": "&Close", "accelerator": "Ctrl+W"}
    ]},
    {"label": "&Position", "items": [
      {"id": "refresh-positions", "label": "&Refresh OpenCPN positions", "accelerator": "Ctrl+U"}
    ]},
    {"label": "&Routings", "items": [
      {"id": "new-routing", "label": "&New", "accelerator": "Ctrl+N"},
      {"id": "load-opencpn-route", "label": "&Load OpenCPN route…", "accelerator": "Ctrl+L"},
      {"id": "edit-routing", "label": "&Edit", "accelerator": "Ctrl+E"},
      {"separator": true},
      {"id": "compute-routing", "label": "&Compute", "accelerator": "Ctrl+C"},
      {"id": "stop-routing", "label": "&Stop", "accelerator": "Ctrl+Z"},
      {"id": "reset-routing", "label": "&Reset", "accelerator": "Ctrl+R"},
      {"id": "delete-routing", "label": "&Delete", "accelerator": "Ctrl+D"},
      {"separator": true},
      {"id": "export-gpx", "label": "E&xport routing as GPX file", "accelerator": "Ctrl+X"},
      {"id": "send-to-opencpn", "label": "Send selected route to &OpenCPN"}
    ]},
    {"label": "&View", "items": [
      {"id": "show-configuration", "label": "&Configuration"},
      {"id": "show-results", "label": "&Results"},
      {"separator": true},
      {"id": "show-isochrones", "label": "Show selected-route &isochrones", "checkable": true},
      {"id": "show-stability-corridor", "label": "Show departure-route stability &corridor", "checkable": true},
      {"id": "show-route-wind", "label": "Show route-time &wind barbs", "checkable": true},
      {"id": "route-to-cursor", "label": "Selected isochrone route to chart &cursor", "checkable": true},
      {"id": "boat-at-grib-time", "label": "Boat at iGRIB forecast &time", "checkable": true}
    ]},
    {"label": "&Help", "items": [
      {"id": "about", "label": "&About iWeatherRouting"}
    ]}
  ],
  "manager": {
    "positions": {"label": "Positions", "columns": ["Name", "Lat", "Lon", "Source"]},
    "routings": {"label": "Routings", "columns": ["Vis", "Start Type", "Start", "Start Time", "End", "End Time", "Time", "Distance", "State"]},
    "actions": [
      {"id": "new-routing", "label": "&New"},
      {"id": "edit-routing", "label": "&Edit"},
      {"id": "compute-routing", "label": "&Compute"},
      {"id": "send-to-opencpn", "label": "&Save in OpenCPN"},
      {"id": "export-gpx", "label": "Export as &GPX"}
    ]
  },
  "tabs": ["Basic", "Advanced", "Safety & Engine", "Results"],
  "controls": [
    {"id": "start-source", "tab": "Basic", "type": "position-source", "label": "Start from"},
    {"id": "start-waypoint", "tab": "Basic", "type": "navigation-object", "label": "Waypoint"},
    {"id": "start-latitude", "tab": "Basic", "type": "number", "label": "Latitude"},
    {"id": "start-longitude", "tab": "Basic", "type": "number", "label": "Longitude"},
    {"id": "destination-source", "tab": "Basic", "type": "position-source", "label": "End at"},
    {"id": "destination-waypoint", "tab": "Basic", "type": "navigation-object", "label": "Waypoint"},
    {"id": "destination-latitude", "tab": "Basic", "type": "number", "label": "Latitude"},
    {"id": "destination-longitude", "tab": "Basic", "type": "number", "label": "Longitude"},
    {"id": "refresh-positions", "tab": "Basic", "type": "button", "label": "Refresh OpenCPN positions"},
    {"id": "use-opencpn-route", "tab": "Basic", "type": "toggle", "label": "Use all waypoints from an existing OpenCPN route"},
    {"id": "opencpn-route", "tab": "Basic", "type": "navigation-route", "label": "Route"},
    {"id": "reverse-opencpn-route", "tab": "Basic", "type": "toggle", "label": "Route through the selected OpenCPN route in reverse"},
    {"id": "departure-utc", "tab": "Basic", "type": "departure-time", "label": "Date and time"},
    {"id": "vessel-performance-file", "tab": "Basic", "type": "file-open", "label": "Boat XML or polar file"},
    {"id": "vessel-performance-status", "tab": "Basic", "type": "status", "label": "Vessel performance"},
    {"id": "environment-provider", "tab": "Basic", "type": "status", "label": "Environmental provider"},
    {"id": "avoid-unsafe", "tab": "Basic", "type": "toggle", "label": "Detect Land"},
    {"id": "maximum-true-wind", "tab": "Basic", "type": "optional-number", "label": "Max True Wind (knots)"},
    {"id": "maximum-apparent-wind", "tab": "Basic", "type": "optional-number", "label": "Max Apparent Wind (knots)"},
    {"id": "maximum-wave", "tab": "Basic", "type": "optional-number", "label": "Max Swell (metres)"},
    {"id": "use-currents", "tab": "Basic", "type": "toggle", "label": "Currents"},
    {"id": "use-waves", "tab": "Basic", "type": "toggle", "label": "Waves"},
    {"id": "time-step", "tab": "Basic", "type": "integer", "label": "Time step"},
    {"id": "compare-departures", "tab": "Basic", "type": "toggle", "label": "Optimise departure time"},
    {"id": "departure-window", "tab": "Basic", "type": "integer", "label": "Range before/after start time +/- (minutes)"},
    {"id": "departure-spacing", "tab": "Basic", "type": "integer", "label": "Step (minutes)"},
    {"id": "minimum-wind-angle", "tab": "Advanced", "type": "number", "label": "From (degrees)"},
    {"id": "maximum-wind-angle", "tab": "Advanced", "type": "number", "label": "To (degrees)"},
    {"id": "land-safety-margin", "tab": "Advanced", "type": "number", "label": "Safety Margin From Land (NM)"},
    {"id": "maximum-latitude", "tab": "Advanced", "type": "number", "label": "Max Latitude +/- (degrees)"},
    {"id": "upwind-efficiency", "tab": "Advanced", "type": "number", "label": "Upwind (%)"},
    {"id": "downwind-efficiency", "tab": "Advanced", "type": "number", "label": "Downwind (%)"},
    {"id": "tack-penalty", "tab": "Advanced", "type": "integer", "label": "Tacking Time (seconds)"},
    {"id": "gybe-penalty", "tab": "Advanced", "type": "integer", "label": "Jibing Time (seconds)"},
    {"id": "allow-motor-sailing", "tab": "Advanced", "type": "toggle", "label": "Allow motor-sailing below the sailing-speed threshold"},
    {"id": "allow-motor", "tab": "Advanced", "type": "toggle", "label": "Motor if boat speed is below"},
    {"id": "motor-threshold", "tab": "Advanced", "type": "number", "label": "Threshold (knots)"},
    {"id": "motor-speed", "tab": "Advanced", "type": "number", "label": "Motor speed (knots)"},
    {"id": "motor-sailing-boost", "tab": "Advanced", "type": "number", "label": "Motor-sailing speed increase (knots)"},
    {"id": "motor-hysteresis", "tab": "Advanced", "type": "number", "label": "Propulsion crossover hysteresis (knots)"},
    {"id": "minimum-motor-run", "tab": "Advanced", "type": "integer", "label": "Minimum propulsion run (seconds)"},
    {"id": "mode-change-penalty", "tab": "Advanced", "type": "integer", "label": "Propulsion mode-change penalty (seconds)"},
    {"id": "maximum-motor-hours", "tab": "Advanced", "type": "optional-number", "label": "Maximum propulsion time (hours)"},
    {"id": "fuel-consumption", "tab": "Advanced", "type": "number", "label": "Fuel consumption (litres/hour)"},
    {"id": "maximum-fuel", "tab": "Advanced", "type": "optional-number", "label": "Maximum fuel use (litres)"},
    {"id": "maximum-search-angle", "tab": "Advanced", "type": "number", "label": "Max Search Angle (degrees)"},
    {"id": "destination-tolerance", "tab": "Advanced", "type": "number", "label": "Destination tolerance (NM)"},
    {"id": "reset-advanced", "tab": "Advanced", "type": "button", "label": "Reset all Advanced Parameters"},
    {"id": "require-authoritative-chart-safety", "tab": "Safety & Engine", "type": "toggle", "label": "Require chart-object and depth-aware final validation"},
    {"id": "chart-safety-status", "tab": "Safety & Engine", "type": "status", "label": "Chart safety provider"},
    {"id": "minimum-chart-depth", "tab": "Safety & Engine", "type": "number", "label": "Minimum charted depth (m)"},
    {"id": "maximum-opposing-wind-current", "tab": "Safety & Engine", "type": "optional-number", "label": "Wind-against-current limit (kt²)"},
    {"id": "require-current-data", "tab": "Safety & Engine", "type": "toggle", "label": "Reject states without current data"},
    {"id": "require-wave-data", "tab": "Safety & Engine", "type": "toggle", "label": "Reject states without wave data"},
    {"id": "heading-step", "tab": "Safety & Engine", "type": "integer", "label": "Heading resolution (degrees)"},
    {"id": "adaptive-headings", "tab": "Safety & Engine", "type": "toggle", "label": "Use adaptive heading refinement"},
    {"id": "refined-heading-step", "tab": "Safety & Engine", "type": "integer", "label": "Refined heading resolution (degrees)"},
    {"id": "spatial-cell", "tab": "Safety & Engine", "type": "number", "label": "Search spatial cell (NM)"},
    {"id": "labels-per-cell", "tab": "Safety & Engine", "type": "integer", "label": "Route labels retained per cell and tack"},
    {"id": "maximum-hours", "tab": "Safety & Engine", "type": "integer", "label": "Maximum duration (hours)"},
    {"id": "maximum-states", "tab": "Safety & Engine", "type": "integer", "label": "Maximum retained route states"},
    {"id": "departure-workers", "tab": "Safety & Engine", "type": "integer", "label": "Maximum departure workers (0 = automatic)"},
    {"id": "route-metrics", "tab": "Results", "type": "status", "label": "Route metrics"},
    {"id": "departure-results", "tab": "Results", "type": "table", "label": "Departure comparison results", "columns": ["Best", "Offset", "Departure", "ETA", "Elapsed", "Distance", "State"]},
    {"id": "candidate-details", "tab": "Results", "type": "status", "label": "Selected candidate details"},
    {"id": "route-schedule", "tab": "Results", "type": "table", "label": "Selected route schedule", "columns": ["Time", "Latitude", "Longitude", "Course", "SOG", "Wind", "Waves", "Current", "Source"]},
    {"id": "validation-diagnostics", "tab": "Results", "type": "diagnostics", "label": "Validation diagnostics"},
    {"id": "show-isochrones", "tab": "Results", "type": "toggle", "label": "Show selected-route equal-time isochrones"},
    {"id": "isochrone-display-preset", "tab": "Results", "type": "choice", "label": "Isochrone display"},
    {"id": "isochrone-display-settings", "tab": "Results", "type": "button", "label": "Display settings…"},
    {"id": "show-stability-corridor", "tab": "Results", "type": "toggle", "label": "Show departure-route stability corridor"},
    {"id": "stability-corridor-settings", "tab": "Results", "type": "button", "label": "Corridor settings…"},
    {"id": "show-route-wind", "tab": "Results", "type": "toggle", "label": "Show route-time wind barbs"},
    {"id": "route-to-cursor", "tab": "Results", "type": "toggle", "label": "Show selected isochrone route to chart cursor"},
    {"id": "boat-at-grib-time", "tab": "Results", "type": "toggle", "label": "Show boat position at iGRIB forecast time"},
    {"id": "export-gpx", "tab": "Results", "type": "file-save", "label": "Export route as GPX…"},
    {"id": "send-to-opencpn", "tab": "Results", "type": "navigation-create", "label": "Save selected route in OpenCPN"},
    {"id": "calculate", "tab": "Results", "type": "button", "label": "Calculate route"},
    {"id": "cancel", "tab": "Results", "type": "cancel", "label": "Cancel"},
    {"id": "progress", "tab": "Results", "type": "progress", "label": "Progress"}
  ]
}
