{
  "format_version": 1,
  "id": "org.opencpn.igrib",
  "name": "iGRIB",
  "version": "0.2.0",
  "description": "Portable environmental-data proof of concept for OpenCPN",
  "component": "component/igrib.wasm",
  "runtime": ">=0.1.0 <0.2.0",
  "portable_api": ">=0.5.0 <0.6.0",
  "portable_world": "environment-provider-plugin",
  "surfaces": {
    "environment.viewer": "ui/igrib-viewer.ui.json"
  },
  "provides": [
    {
      "interface": "org.opencpn.environment.provider",
      "version": "0.1.0"
    }
  ],
  "permissions": [
    "ui.commands",
    "ui.surfaces",
    "navigation.position.read",
    "navigation.objects.read",
    "settings.read-write",
    "overlay.submit",
    "jobs.compute",
    "environment.datasets",
    "storage.user-selected",
    "network.providers",
    "helpers.environment.decode",
    "helpers.environment.generate",
    "charts.coverage",
    "network.http",
    "storage.private",
    "credentials.provider"
  ],
  "helpers": {
    "environment-decoder": {
      "protocol": 1,
      "required": true,
      "targets": ["linux-gnu-x86_64", "linux-gnu-aarch64", "flatpak-x86_64", "flatpak-aarch64", "macos-x86_64", "macos-aarch64", "windows-x86_64"]
    },
    "environment-generator": {
      "protocol": 1,
      "required": true,
      "targets": ["linux-gnu-x86_64", "linux-gnu-aarch64", "flatpak-x86_64", "flatpak-aarch64", "macos-x86_64", "macos-aarch64", "windows-x86_64"]
    }
  },
  "resources": [
    "resources/igrib.svg",
    "resources/controls/prev.svg",
    "resources/controls/next.svg",
    "resources/controls/play.svg",
    "resources/controls/stop.svg",
    "resources/controls/now.svg",
    "resources/controls/openfile.svg",
    "resources/controls/setting.svg",
    "resources/controls/curdata.svg",
    "resources/controls/request.svg",
    "resources/controls/ncurdata.svg",
    "resources/fault-test.svg",
    "resources/http-download.svg",
    "ui/igrib-viewer.ui.json"
  ],
  "licenses": ["GPL-2.0-or-later"],
  "development": true
}
