{
  "schema": "org.opencpn.portable-ui/0.2",
  "surface": "routing-workbench",
  "title": "iWeatherRouting — Portable Weather Routing",
  "menus": [
    {"label": "&File", "items": [
      {"id": "close", "label": "&Close", "accelerator": "Ctrl+W"}
    ]},
    {"label": "&Position", "items": [
      {"id": "refresh-positions", "label": "&Refresh OpenCPN positions", "accelerator": "Ctrl+U"}
    ]},
    {"label": "&Routings", "items": [
      {"id": "new-routing", "label": "&New", "accelerator": "Ctrl+N"},
      {"id": "edit-routing", "label": "&Edit", "accelerator": "Ctrl+E"},
      {"separator": true},
      {"id": "compute-routing", "label": "&Compute", "accelerator": "Ctrl+C"},
      {"id": "stop-routing", "label": "&Stop", "accelerator": "Ctrl+Z"},
      {"separator": true},
      {"id": "export-gpx", "label": "E&xport routing as GPX file", "accelerator": "Ctrl+X"},
      {"id": "send-to-opencpn", "label": "Send selected route to &OpenCPN"}
    ]},
    {"label": "&View", "items": [
      {"id": "show-configuration", "label": "&Configuration"},
      {"id": "show-results", "label": "&Results"},
      {"separator": true},
      {"id": "show-isochrones", "label": "Show selected-route &isochrones", "checkable": true},
      {"id": "show-stability-corridor", "label": "Show departure-route stability &corridor", "checkable": true},
      {"id": "show-route-wind", "label": "Show route-time &wind barbs", "checkable": true},
      {"id": "route-to-cursor", "label": "Route to chart &cursor", "checkable": true},
      {"id": "boat-at-grib-time", "label": "Boat at iGRIB forecast &time", "checkable": true}
    ]},
    {"label": "&Help", "items": [
      {"id": "about", "label": "&About iWeatherRouting"}
    ]}
  ],
  "manager": {
    "positions": {"label": "Positions", "columns": ["Name", "Latitude", "Longitude", "Source"]},
    "routings": {"label": "Routings", "columns": ["State", "Start", "End", "Departure", "ETA", "Elapsed", "Distance"]},
    "actions": [
      {"id": "compute-routing", "label": "&Compute"},
      {"id": "edit-routing", "label": "&Edit"},
      {"id": "export-gpx", "label": "Export as &GPX"}
    ]
  },
  "tabs": ["Route and weather", "Vessel and safety", "Advanced", "Results"],
  "controls": [
    {"id": "start-source", "tab": "Route and weather", "type": "position-source", "label": "Start from"},
    {"id": "start-waypoint", "tab": "Route and weather", "type": "navigation-object", "label": "Start waypoint"},
    {"id": "start-latitude", "tab": "Route and weather", "type": "number", "label": "Start latitude"},
    {"id": "start-longitude", "tab": "Route and weather", "type": "number", "label": "Start longitude"},
    {"id": "destination-source", "tab": "Route and weather", "type": "position-source", "label": "Destination from"},
    {"id": "destination-waypoint", "tab": "Route and weather", "type": "navigation-object", "label": "Destination waypoint"},
    {"id": "destination-latitude", "tab": "Route and weather", "type": "number", "label": "Destination latitude"},
    {"id": "destination-longitude", "tab": "Route and weather", "type": "number", "label": "Destination longitude"},
    {"id": "refresh-positions", "tab": "Route and weather", "type": "button", "label": "Refresh OpenCPN positions"},
    {"id": "use-opencpn-route", "tab": "Route and weather", "type": "toggle", "label": "Route through an existing OpenCPN route"},
    {"id": "opencpn-route", "tab": "Route and weather", "type": "navigation-route", "label": "OpenCPN route and intermediate waypoints"},
    {"id": "departure-utc", "tab": "Route and weather", "type": "utc-time", "label": "Departure UTC"},
    {"id": "vessel-performance-file", "tab": "Route and weather", "type": "file-open", "label": "Boat XML or polar file"},
    {"id": "vessel-performance-status", "tab": "Route and weather", "type": "status", "label": "Vessel performance"},
    {"id": "environment-provider", "tab": "Route and weather", "type": "status", "label": "Environmental provider"},
    {"id": "avoid-unsafe", "tab": "Vessel and safety", "type": "toggle", "label": "Reject unsafe or uncovered chart segments"},
    {"id": "minimum-wind-angle", "tab": "Vessel and safety", "type": "number", "label": "Minimum true-wind angle (degrees)"},
    {"id": "maximum-wind-angle", "tab": "Vessel and safety", "type": "number", "label": "Maximum true-wind angle (degrees)"},
    {"id": "maximum-true-wind", "tab": "Vessel and safety", "type": "optional-number", "label": "Maximum true-wind speed (kt)"},
    {"id": "maximum-apparent-wind", "tab": "Vessel and safety", "type": "optional-number", "label": "Maximum apparent-wind speed (kt)"},
    {"id": "maximum-wave", "tab": "Vessel and safety", "type": "optional-number", "label": "Maximum significant wave height (m)"},
    {"id": "maximum-opposing-wind-current", "tab": "Vessel and safety", "type": "optional-number", "label": "Wind-against-current limit (kt²)"},
    {"id": "land-safety-margin", "tab": "Vessel and safety", "type": "number", "label": "Safety margin from land (NM)"},
    {"id": "use-currents", "tab": "Vessel and safety", "type": "toggle", "label": "Use forecast currents"},
    {"id": "require-current-data", "tab": "Vessel and safety", "type": "toggle", "label": "Reject states without current data"},
    {"id": "use-waves", "tab": "Vessel and safety", "type": "toggle", "label": "Use forecast waves"},
    {"id": "require-wave-data", "tab": "Vessel and safety", "type": "toggle", "label": "Reject states without wave data"},
    {"id": "maximum-latitude", "tab": "Vessel and safety", "type": "number", "label": "Maximum absolute latitude (degrees)"},
    {"id": "upwind-efficiency", "tab": "Vessel and safety", "type": "number", "label": "Upwind polar efficiency (%)"},
    {"id": "downwind-efficiency", "tab": "Vessel and safety", "type": "number", "label": "Downwind polar efficiency (%)"},
    {"id": "tack-penalty", "tab": "Vessel and safety", "type": "integer", "label": "Tack time penalty (seconds)"},
    {"id": "gybe-penalty", "tab": "Vessel and safety", "type": "integer", "label": "Gybe time penalty (seconds)"},
    {"id": "allow-motor-sailing", "tab": "Vessel and safety", "type": "toggle", "label": "Allow motor-sailing below the sailing-speed threshold"},
    {"id": "allow-motor", "tab": "Vessel and safety", "type": "toggle", "label": "Allow motor-only propulsion below the sailing-speed threshold"},
    {"id": "motor-threshold", "tab": "Vessel and safety", "type": "number", "label": "Engage propulsion below sailing speed (kt)"},
    {"id": "motor-speed", "tab": "Vessel and safety", "type": "number", "label": "Motor-only speed through water (kt)"},
    {"id": "motor-sailing-boost", "tab": "Vessel and safety", "type": "number", "label": "Motor-sailing speed increase (kt)"},
    {"id": "motor-hysteresis", "tab": "Vessel and safety", "type": "number", "label": "Propulsion crossover hysteresis (kt)"},
    {"id": "minimum-motor-run", "tab": "Vessel and safety", "type": "integer", "label": "Minimum propulsion run (seconds)"},
    {"id": "mode-change-penalty", "tab": "Vessel and safety", "type": "integer", "label": "Propulsion mode-change penalty (seconds)"},
    {"id": "maximum-motor-hours", "tab": "Vessel and safety", "type": "optional-number", "label": "Maximum propulsion time (hours)"},
    {"id": "fuel-consumption", "tab": "Vessel and safety", "type": "number", "label": "Fuel consumption while propelling (litres/hour)"},
    {"id": "maximum-fuel", "tab": "Vessel and safety", "type": "optional-number", "label": "Maximum fuel use (litres)"},
    {"id": "time-step", "tab": "Advanced", "type": "integer", "label": "Time step (seconds)"},
    {"id": "heading-step", "tab": "Advanced", "type": "integer", "label": "Heading resolution (degrees)"},
    {"id": "adaptive-headings", "tab": "Advanced", "type": "toggle", "label": "Use adaptive heading refinement"},
    {"id": "refined-heading-step", "tab": "Advanced", "type": "integer", "label": "Refined heading resolution (degrees)"},
    {"id": "spatial-cell", "tab": "Advanced", "type": "number", "label": "Search spatial cell (NM)"},
    {"id": "labels-per-cell", "tab": "Advanced", "type": "integer", "label": "Route labels retained per cell and tack"},
    {"id": "maximum-search-angle", "tab": "Advanced", "type": "number", "label": "Maximum search angle either side (degrees)"},
    {"id": "destination-tolerance", "tab": "Advanced", "type": "number", "label": "Destination tolerance (NM)"},
    {"id": "maximum-hours", "tab": "Advanced", "type": "integer", "label": "Maximum duration (hours)"},
    {"id": "maximum-states", "tab": "Advanced", "type": "integer", "label": "Maximum route states"},
    {"id": "compare-departures", "tab": "Advanced", "type": "toggle", "label": "Compare a forward departure-time window"},
    {"id": "departure-window", "tab": "Advanced", "type": "integer", "label": "Departure window (hours)"},
    {"id": "departure-spacing", "tab": "Advanced", "type": "integer", "label": "Departure spacing (hours)"},
    {"id": "departure-workers", "tab": "Advanced", "type": "integer", "label": "Parallel departure workers"},
    {"id": "route-metrics", "tab": "Results", "type": "status", "label": "Route metrics"},
    {"id": "departure-results", "tab": "Results", "type": "table", "label": "Departure comparison results", "columns": ["Best", "Offset", "Departure", "ETA", "Elapsed", "Distance", "Avg Speed", "Avg SOG", "Max SOG", "Avg Wind", "Max Wind", "Avg Current", "Max Current", "Tacks", "Motor", "Fuel", "Mode changes", "Comfort", "States", "Isochrones", "State"]},
    {"id": "route-schedule", "tab": "Results", "type": "table", "label": "Selected route schedule", "columns": ["UTC", "Latitude", "Longitude", "Course", "SOG", "Wind", "Waves", "Current", "Source"]},
    {"id": "validation-diagnostics", "tab": "Results", "type": "diagnostics", "label": "Validation diagnostics"},
    {"id": "show-isochrones", "tab": "Results", "type": "toggle", "label": "Show selected-route isochrones"},
    {"id": "show-stability-corridor", "tab": "Results", "type": "toggle", "label": "Show departure-route stability corridor"},
    {"id": "show-route-wind", "tab": "Results", "type": "toggle", "label": "Show route-time wind barbs"},
    {"id": "route-to-cursor", "tab": "Results", "type": "toggle", "label": "Show search route nearest chart cursor"},
    {"id": "boat-at-grib-time", "tab": "Results", "type": "toggle", "label": "Show boat position at iGRIB forecast time"},
    {"id": "export-gpx", "tab": "Results", "type": "file-save", "label": "Export route as GPX…"},
    {"id": "send-to-opencpn", "tab": "Results", "type": "navigation-create", "label": "Send selected route to OpenCPN"},
    {"id": "calculate", "tab": "Results", "type": "button", "label": "Calculate route"},
    {"id": "cancel", "tab": "Results", "type": "cancel", "label": "Cancel"},
    {"id": "progress", "tab": "Results", "type": "progress", "label": "Progress"}
  ]
}
