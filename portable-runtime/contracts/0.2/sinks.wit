package opencpn:portable@0.2.0;

interface surface-event-sink {
  use types.{service-error};

  on-surface-event: func(
    surface-id: string,
    control-id: string,
    value-json: string,
  ) -> result<string, service-error>;
}

interface job-event-sink {
  use types.{job-event};

  on-job-event: func(job-id: string, event: job-event);
}
