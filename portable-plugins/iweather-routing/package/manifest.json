{
  "format_version": 1,
  "id": "org.opencpn.iweather-routing",
  "name": "iWeatherRouting",
  "version": "0.2.0",
  "description": "Portable weather routing for OpenCPN",
  "component": "component/iweather-routing.wasm",
  "runtime": ">=0.1.0 <0.2.0",
  "portable_api": ">=0.5.0 <0.6.0",
  "portable_world": "passage-weather-routing-plugin",
  "requires": [
    {"interface": "org.opencpn.environment.provider", "range": ">=0.1.0 <0.2.0"}
  ],
  "surfaces": {
    "routing.workbench": "ui/iweather-routing.ui.json"
  },
  "permissions": ["ui.commands", "ui.surfaces", "settings.read-write",
                  "navigation.position.read", "navigation.objects.read",
                  "weather-routing.compute", "environment.consume",
                  "charts.coverage", "charts.segment-safety", "storage.user-selected",
                  "navigation.routes.write"],
  "resources": ["resources/iweather-routing.svg",
                "resources/Nicholson35_Mk1_cruising_realistic.pol",
                "ui/iweather-routing.ui.json"],
  "licenses": ["GPL-2.0-or-later"],
  "development": true
}
