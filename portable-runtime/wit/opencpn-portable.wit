package opencpn:portable@0.1.0;

interface host {
  enum log-level {
    debug,
    info,
    warning,
    error,
  }

  record vessel-position {
    latitude: f64,
    longitude: f64,
    course-over-ground: option<f64>,
    speed-over-ground: option<f64>,
  }

  record geo-point {
    latitude: f64,
    longitude: f64,
  }

  record overlay-style {
    red: u8,
    green: u8,
    blue: u8,
    alpha: u8,
    width-pixels: f32,
  }

  record geo-segment {
    start: geo-point,
    end: geo-point,
  }

  enum chart-coverage-state {
    covered,
    unsafe,
    missing-coverage,
    unknown,
  }

  record chart-segment-result {
    state: chart-coverage-state,
    charts-considered: u32,
    diagnostic: string,
  }

  record environment-sample-request {
    latitude: f64,
    longitude: f64,
    unix-time: s64,
  }

  record environment-sample {
    wind-u-knots: option<f64>,
    wind-v-knots: option<f64>,
    current-u-knots: option<f64>,
    current-v-knots: option<f64>,
    wave-height-metres: option<f64>,
  }

  log: func(level: log-level, message: string);
  register-action: func(action-id: string, label: string, tooltip: string,
                        icon-resource: option<string>) -> result<u32, string>;
  get-vessel-position: func() -> result<vessel-position, string>;
  setting-get: func(key: string) -> result<option<string>, string>;
  setting-set: func(key: string, value: string) -> result<_, string>;
  submit-polyline: func(scene-id: string, points: list<geo-point>,
                        style: overlay-style) -> result<_, string>;
  clear-scene: func(scene-id: string) -> result<_, string>;
  start-job: func(job-id: string, work-units: u32) -> result<_, string>;
  cancel-job: func(job-id: string) -> result<_, string>;
  open-environmental-viewer: func() -> result<_, string>;
  open-weather-routing: func() -> result<_, string>;
  environment-sample-batch: func(requests: list<environment-sample-request>) -> result<list<environment-sample>, string>;
  routing-progress: func(percent: u8, message: string);
  routing-cancelled: func() -> bool;
  charts-query-segments: func(segments: list<geo-segment>) -> result<list<chart-segment-result>, string>;
  network-get-to-private: func(request-id: string, url: string,
                               private-name: string, max-bytes: u64) -> result<_, string>;
  storage-private-read: func(private-name: string) -> result<list<u8>, string>;
}

interface plugin {
  record plugin-info {
    id: string,
    name: string,
    version: string,
  }

  variant job-event {
    progress(u8),
    completed,
    cancelled,
    failed(string),
  }

  record route-request {
    start-latitude: f64,
    start-longitude: f64,
    destination-latitude: f64,
    destination-longitude: f64,
    departure-unix-time: s64,
    boat-speed-knots: f64,
    time-step-seconds: u32,
    heading-step-degrees: u16,
    max-hours: u32,
    max-states: u32,
    avoid-unsafe-charts: bool,
    min-true-wind-angle-degrees: f64,
    max-true-wind-angle-degrees: f64,
    max-wind-knots: option<f64>,
    max-apparent-wind-knots: option<f64>,
    max-wave-metres: option<f64>,
    use-currents: bool,
    require-current-data: bool,
    use-waves: bool,
    require-wave-data: bool,
    maximum-latitude-degrees: f64,
    upwind-efficiency: f64,
    downwind-efficiency: f64,
    tack-penalty-seconds: u32,
    gybe-penalty-seconds: u32,
    maximum-search-angle-degrees: f64,
    destination-tolerance-nm: f64,
  }

  record route-point {
    latitude: f64,
    longitude: f64,
    unix-time: s64,
  }

  record route-result {
    points: list<route-point>,
    distance-nautical-miles: f64,
    duration-seconds: u64,
    states-examined: u32,
    diagnostic: string,
  }

  initialize: func() -> result<plugin-info, string>;
  enable: func() -> result<_, string>;
  disable: func();
  on-action: func(action-id: string) -> result<_, string>;
  on-job-event: func(job-id: string, event: job-event);
  calculate-route: func(request: route-request) -> result<route-result, string>;
  test-trap: func();
}

world plugin-world {
  import host;
  export plugin;
}
