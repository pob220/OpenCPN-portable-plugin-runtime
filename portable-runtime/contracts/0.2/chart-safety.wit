package opencpn:portable@0.2.0;

interface chart-safety {
  use types.{
    chart-segment-result,
    final-chart-safety-options,
    geo-segment,
    service-error,
  };

  query-segments: func(segments: list<geo-segment>)
    -> result<list<chart-segment-result>, service-error>;
  query-final-safety: func(
    segments: list<geo-segment>,
    options: final-chart-safety-options,
  ) -> result<list<chart-segment-result>, service-error>;
}
