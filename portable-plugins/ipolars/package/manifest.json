{
  "format_version": 1,
  "id": "org.opencpn.ipolars",
  "name": "iPolars",
  "version": "0.2.0",
  "description": "OPP API 0.4 polar and OpenCPN Weather Routing boat editor",
  "component": "component/ipolars.wasm",
  "runtime": ">=0.1.0 <0.2.0",
  "portable_api": ">=0.4.0 <0.5.0",
  "portable_world": "plugin",
  "surfaces": {
    "polars.editor": "ui/ipolars.ui.json"
  },
  "event_subscriptions": [
    {
      "event": "navigation.nmea0183",
      "topic_prefix": "$",
      "queue_limit": 128
    }
  ],
  "provides": [
    {
      "interface": "org.opencpn.vessel-performance.editor",
      "version": "0.1.0"
    }
  ],
  "permissions": [
    "ui.commands",
    "ui.surfaces",
    "storage.user-selected",
    "navigation.nmea.read"
  ],
  "resources": [
    "resources/ipolars.svg",
    "ui/ipolars.ui.json"
  ],
  "licenses": ["GPL-2.0-or-later"],
  "development": true
}
