{
  "format_version": 1,
  "id": "org.opencpn.igrib",
  "name": "iGRIB",
  "version": "0.1.0",
  "description": "Portable environmental-data proof of concept for OpenCPN",
  "component": "component/igrib.wasm",
  "runtime": ">=0.1.0 <0.2.0",
  "portable_api": ">=0.1.0 <0.2.0",
  "services": [
    {
      "interface": "org.opencpn.environment.viewer",
      "range": ">=0.1.0 <0.2.0",
      "provider": "OpenCPN host environmental service"
    }
  ],
  "permissions": [
    "ui.commands",
    "navigation.position.read",
    "settings.read-write",
    "overlay.submit",
    "jobs.compute",
    "environment.datasets",
    "storage.user-selected",
    "network.providers",
    "helpers.environment.decode",
    "helpers.environment.generate",
    "charts.coverage",
    "network.http",
    "storage.private",
    "credentials.provider"
  ],
  "helpers": {
    "environment-decoder": {
      "protocol": 1,
      "required": true,
      "targets": ["linux-gnu-x86_64", "linux-gnu-aarch64", "macos-x86_64", "macos-aarch64", "windows-x86_64"]
    },
    "environment-generator": {
      "protocol": 1,
      "required": false,
      "targets": ["linux-gnu-x86_64", "linux-gnu-aarch64", "macos-x86_64", "macos-aarch64", "windows-x86_64"]
    }
  },
  "resources": [
    "resources/grib.svg",
    "resources/fault-test.svg",
    "resources/http-download.svg",
    "ui/igrib-viewer.ui.json"
  ],
  "licenses": ["GPL-2.0-or-later"],
  "development": true
}
